# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arquivos-fonte de marketing (zips do Drive) — não versionar
*.zip

# Pastas-fonte vindas do Drive (logos, artes, briefs) — o que entra no site vive em /public
/ATRAÇÕES
/Apresentações
/Arte do Evento
/LANDING PAGE
/LOGO PATROCINADORES
/PROJETO
